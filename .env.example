# Локальная LLM (Ollama)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
# Альтернатива (русский — родной, но чаще выдумывает факты): hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M
LLM_TIMEOUT=300
LLM_WARMUP=true

# Распознавание речи (faster-whisper)
STT_MODEL=large-v3-turbo

# Данные: SQLite-база, обученная модель удержания
# DATA_DIR=data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/wsa

# Синтетика и обучение модели удержания
ML_TRAIN_ROWS=6000
SEED=42
